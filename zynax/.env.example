# Optional. Chat, notes, quizzes, and AI study plans need this.
# Without it, those buttons explain that the AI provider is not configured.
# Timetable, attendance maths, PDF text search, and OTP preview still work.
XAI_API_KEY=

# Optional. Leave empty for a local preview. Student records stay in the browser.
# Set this on Vercel only if you use the hosted Postgres integration.
DATABASE_URL=
